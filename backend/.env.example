# Environment
NODE_ENV=development
PORT=5001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info

# Deeplink Security
# IMPORTANT: Change this in production! Minimum 32 characters
DEEPLINK_SECRET=change-this-secret-in-production-min-32-chars-required

# Appointment notification recipient
APPOINTMENT_NOTIFICATION_EMAIL=rphospital456@gmail.com
# Optional dedicated careers recipient
CAREERS_NOTIFICATION_EMAIL=rphospital123@gmail.com

# Recommended: Resend API (primary mail provider)
# Create key at https://resend.com and verify your sending domain
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM=RP Hospital Careers <careers@rphospitals.in>

# SMTP settings for appointment emails
# Example for Gmail SMTP: smtp.gmail.com, port 587, secure false
# Optional fallback if Resend is unavailable


# Optional: Uncomment when you add database support
# DATABASE_URL="postgresql://user:password@localhost:5432/rkhospital?schema=public"

# Optional: Uncomment when you add authentication
# JWT_SECRET=your-secret-key-change-in-production
